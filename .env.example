# Uganda Buildcon International Expo — environment variables
# Copy this file to .env.local and fill in real values for local development.
# Never commit .env.local or any file containing real secrets.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://ugandabuildcon.com
# Google Search Console verification token for the ugandabuildcon.com property (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- MongoDB Atlas ---
MONGODB_URI=
MONGODB_DB=uganda_buildcon

# --- Admin auth (Auth.js) ---
# Generate with: npx auth secret
AUTH_SECRET=
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# --- Google reCAPTCHA v2 (keys are domain-bound: register ugandabuildcon.com + localhost) ---
# Leave both empty to disable the widget and server check.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Google Sheets sync (service account) ---
GOOGLE_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The full service-account JSON key, base64-encoded on a single line.
GOOGLE_CREDENTIALS_BASE64=
# ID of the Uganda leads spreadsheet (must contain a "Website Enquiries" tab)
GOOGLE_SHEET_ID=

# --- Email (Nodemailer / Gmail) ---
# The app uses OAuth2 if the three MAIL_CLIENT_* / MAIL_REFRESH_TOKEN vars are set,
# otherwise it falls back to MAIL_APP_PASSWORD.
MAIL_PROVIDER=gmail
MAIL_FROM_NAME=Uganda Buildcon
MAIL_FROM_EMAIL=
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=
MAIL_REFRESH_TOKEN=

# Both organiser inboxes receive every lead notification
FORM_NOTIFICATION_EMAIL_1=
FORM_NOTIFICATION_EMAIL_2=

# --- Contact details shown on the Contact page ---
NEXT_PUBLIC_CONTACT_EXHIBITOR_EMAIL=
NEXT_PUBLIC_CONTACT_EXHIBITOR_PHONE=
NEXT_PUBLIC_CONTACT_INTERNATIONAL_EMAIL=
NEXT_PUBLIC_CONTACT_INTERNATIONAL_PHONE=
NEXT_PUBLIC_CONTACT_VISITOR_EMAIL=
NEXT_PUBLIC_CONTACT_VISITOR_PHONE=
NEXT_PUBLIC_CONTACT_GENERAL_EMAIL=
NEXT_PUBLIC_CONTACT_GENERAL_PHONE=

# --- Social links (footer) ---
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TWITTER=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# --- Analytics (all optional; only loaded with cookie consent) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# --- Spam protection (optional) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
